    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token Monitor connects to your Token Monitor Hub on the local network to show your AI token usage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token Monitor は、AI トークンの使用量を表示するために、ローカルネットワーク上の Token Monitor Hub に接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token Monitor는 AI 토큰 사용량을 표시하기 위해 로컬 네트워크의 Token Monitor Hub에 연결합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Token Monitor se conecta ao seu Token Monitor Hub na rede local para mostrar o uso de tokens de IA."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token Monitor 会连接本地网络上的 Token Monitor Hub，以显示你的 AI Token 用量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token Monitor 會連線到區域網路上的 Token Monitor Hub，以顯示你的 AI Token 用量。"
          }
        }
      }
