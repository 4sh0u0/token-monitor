          }
        }
      }
    },
    "The middle choice of the Overview’s period picker. This week, Last 7 days and Last 30 days are built from the Hub’s history." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The middle choice of the Overview’s period picker. This week, Last 7 days and Last 30 days are built from the Hub’s history."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "概要の期間ピッカーの中央の選択肢です。「今週」「過去7日間」「過去30日間」は Hub の履歴から集計されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개요 기간 선택기의 가운데 항목입니다. 이번 주, 최근 7일, 최근 30일은 Hub의 기록으로 계산됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A opção do meio do seletor de período da Visão geral. Esta semana, Últimos 7 dias e Últimos 30 dias são calculados a partir do histórico do Hub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总览期间选择器中间的选项。本周、最近 7 天和最近 30 天根据 Hub 的历史记录计算。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
