    "Usage, cost, tool limits and subscriptions sync automatically." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage, cost, tool limits and subscriptions sync automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用量、費用、ツールの利用枠、サブスクリプション情報は自動で同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용량, 비용, 도구 한도 및 구독 정보는 자동으로 동기화됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uso, custo, limites das ferramentas e assinaturas são sincronizados automaticamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用量、费用、工具额度与订阅资料会自动同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用量、費用、工具額度與訂閱資料會自動同步。"
          }
        }
      }
    },
