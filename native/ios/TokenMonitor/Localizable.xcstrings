    },
    "Choose which limit providers appear on the Overview. Default is least remaining first; drag here to use a custom order." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which limit providers appear on the Overview. Default is least remaining first; drag here to use a custom order."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "概要に表示する上限プロバイダーを選択します。既定では残量の少ない順に並びます。ここにドラッグすると任意の順序を使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개요에 표시할 한도 제공자를 선택하세요. 기본값은 남은 양이 적은 순이며, 여기로 드래그하면 사용자 지정 순서를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quais provedores de limites aparecem na visão geral. O padrão é menor saldo primeiro; arraste aqui para usar uma ordem personalizada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择总览额度模块显示哪些提供者。默认按剩余额度最少优先；拖拽后才按此排序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇總覽額度模組顯示哪些提供者。預設按剩餘額度最少優先；拖曳後才按此排序。"
          }
        }
      }
    },
    "Choose which modules appear on the Overview and their order. Hiding the last visible module shows every module again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which modules appear on the Overview and their order. Hiding the last visible module shows every module again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "概要に表示するモジュールとその順序を選びます。最後に表示されているモジュールを非表示にすると、すべてのモジュールが再び表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개요에 표시할 모듈과 순서를 선택합니다. 마지막으로 표시된 모듈을 숨기면 모든 모듈이 다시 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quais módulos aparecem na Visão geral e a ordem deles. Ocultar o último módulo visível mostra todos os módulos novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择总览中显示哪些模块及其顺序。隐藏最后一个可见模块时，会重新显示所有模块。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇總覽中顯示哪些模組及其順序。隱藏最後一個可見模組時，會重新顯示所有模組。"
          }
        }
      }
    },
    "Choose which services appear on the Status view and their order." : {
