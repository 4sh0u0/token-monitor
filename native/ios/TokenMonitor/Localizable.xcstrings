    "Add your Hub’s address and secret in Settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your Hub’s address and secret in Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定で Hub のアドレスとシークレットを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 Hub 주소와 시크릿을 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o endereço e o segredo do seu Hub em Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在设置中添加 Hub 的地址和密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在設定中新增 Hub 的位址和密鑰。"
          }
        }
      }
    },
    "Addresses on your local network or tailnet use http:// unless you type https://." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addresses on your local network or tailnet use http:// unless you type https://."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルネットワークまたは tailnet 上のアドレスは、https:// と入力しない限り http:// を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 네트워크나 tailnet의 주소는 https://를 입력하지 않으면 http://를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endereços na sua rede local ou tailnet usam http://, a menos que você digite https://."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地网络或 tailnet 上的地址默认使用 http://，除非你输入 https://。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "區域網路或 tailnet 上的位址預設使用 http://，除非你輸入 https://。"
          }
        }
      }
    },
    "All devices are offline. These are the last numbers they reported." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All devices are offline. These are the last numbers they reported."
