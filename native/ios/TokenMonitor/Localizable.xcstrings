    "Live keeps a connection to the Hub open while Token Monitor is on screen. The other choices check the Hub at that interval and hide the live token rate." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live keeps a connection to the Hub open while Token Monitor is on screen. The other choices check the Hub at that interval and hide the live token rate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ライブ」は Token Monitor が画面に表示されている間、Hub との接続を保ちます。その他の選択肢では指定した間隔で Hub を確認し、ライブ Token レートは表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간은 Token Monitor가 화면에 표시되는 동안 Hub 연결을 유지합니다. 다른 옵션은 해당 간격으로 Hub를 확인하며 실시간 토큰 속도는 숨겨집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao vivo mantém uma conexão com o Hub aberta enquanto o Token Monitor está na tela. As outras opções consultam o Hub nesse intervalo e ocultam a taxa de tokens ao vivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时会在 Token Monitor 显示于屏幕上时保持与 Hub 的连接。其他选项会按该间隔检查 Hub，并隐藏实时 Token 速率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時會在 Token Monitor 顯示於螢幕上時保持與 Hub 的連線。其他選項會依該間隔檢查 Hub，並隱藏即時 Token 速率。"
          }
        }
      }
    },
    "Live rate scope" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live rate scope"
