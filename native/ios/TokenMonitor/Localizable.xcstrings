        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ Token レートは、アプリのデータ更新が「ライブ」のときだけ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 토큰 속도는 앱 데이터 업데이트가 실시간으로 설정된 경우에만 표시됩니다."
          }
        },
        "pt-BR" : {
