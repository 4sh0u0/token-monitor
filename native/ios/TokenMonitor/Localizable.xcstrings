    "Widgets and complications refresh when iOS allows; the system may delay them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets and complications refresh when iOS allows; the system may delay them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェットとコンプリケーションは iOS が許可したときに更新されます。システムにより遅れる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위젯과 컴플리케이션은 iOS가 허용할 때 새로 고쳐지며, 시스템이 지연시킬 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets e complicações são atualizados quando o iOS permite; o sistema pode atrasá-los."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小组件和复杂功能会在 iOS 允许时刷新，系统可能会延后。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小工具和複雜功能會在 iOS 允許時重新整理，系統可能會延後。"
          }
        }
      }
    },
