    "Shows the latest generation speed on the Overview. Tap it there to switch between tok/s and TPM." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the latest generation speed on the Overview. Tap it there to switch between tok/s and TPM."
          }
