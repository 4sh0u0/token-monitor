        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各サービスの公開ステータスページを直接確認します。Hub の情報は送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 서비스의 공개 상태 페이지에서 직접 확인합니다. Hub의 정보는 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
