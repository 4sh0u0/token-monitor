    "On an always-on machine, set TOKEN_MONITOR_SECRET in .env and run “npm run hub”. It listens on port 17321." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On an always-on machine, set TOKEN_MONITOR_SECRET in .env and run “npm run hub”. It listens on port 17321."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常時稼働のマシンで .env に TOKEN_MONITOR_SECRET を設定し、「npm run hub」を実行します。ポート 17321 で待ち受けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 켜져 있는 컴퓨터에서 .env에 TOKEN_MONITOR_SECRET을 설정하고 “npm run hub”를 실행하세요. 포트 17321에서 수신합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em uma máquina sempre ligada, defina TOKEN_MONITOR_SECRET no .env e execute “npm run hub”. Ele escuta na porta 17321."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一台常开的机器上，于 .env 中设置 TOKEN_MONITOR_SECRET，然后运行“npm run hub”。它监听 17321 端口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一台常開的機器上，於 .env 中設定 TOKEN_MONITOR_SECRET，然後執行「npm run hub」。它監聽 17321 連接埠。"
          }
        }
      }
    },
    "Online" : {
      "localizations" : {
        "en" : {
