    "The Hub address and secret are removed from this iPhone, its widgets and your Apple Watch." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Hub address and secret are removed from this iPhone, its widgets and your Apple Watch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub のアドレスとシークレットが、この iPhone、ウィジェット、Apple Watch から削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub 주소와 시크릿이 이 iPhone, 위젯 및 Apple Watch에서 삭제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O endereço e o segredo do Hub serão removidos deste iPhone, dos widgets e do seu Apple Watch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub 地址和密钥将从这台 iPhone、其小组件和你的 Apple Watch 中移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub 位址和密鑰將從這支 iPhone、其小工具和你的 Apple Watch 中移除。"
          }
        }
      }
    },
    "The Hub has no secret configured" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Hub has no secret configured"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub にシークレットが設定されていません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub에 시크릿이 설정되지 않음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hub não tem um segredo configurado"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub 未配置密钥"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub 未設定密鑰"
          }
        }
      }
    },
    "The Hub rejected the secret. Enter the Hub’s TOKEN_MONITOR_SECRET, or the secret shown by the desktop widget that hosts the Hub." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Hub rejected the secret. Enter the Hub’s TOKEN_MONITOR_SECRET, or the secret shown by the desktop widget that hosts the Hub."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub がシークレットを拒否しました。Hub の TOKEN_MONITOR_SECRET、または Hub をホストしているデスクトップウィジェットに表示されたシークレットを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub가 시크릿을 거부했습니다. Hub의 TOKEN_MONITOR_SECRET 또는 Hub를 호스팅하는 데스크톱 위젯에 표시된 시크릿을 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Hub rejeitou o segredo. Informe o TOKEN_MONITOR_SECRET do Hub ou o segredo exibido pelo widget de desktop que hospeda o Hub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub 拒绝了该密钥。请输入 Hub 的 TOKEN_MONITOR_SECRET，或托管 Hub 的桌面小组件中显示的密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub 拒絕了此密鑰。請輸入 Hub 的 TOKEN_MONITOR_SECRET，或架設 Hub 的桌面小工具中顯示的密鑰。"
          }
        }
      }
    },
    "The Hub secret couldn’t be read (error %@). Enter it again in Settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Hub secret couldn’t be read (error %@). Enter it again in Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub のシークレットを読み取れませんでした（エラー %@）。設定で再入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub 시크릿을 읽을 수 없습니다(오류 %@). 설정에서 다시 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler o segredo do Hub (erro %@). Informe-o novamente em Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 Hub 密钥（错误 %@）。请在设置中重新输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取 Hub 密鑰（錯誤 %@）。請在設定中重新輸入。"
          }
        }
      }
    },
    "The address answered, but not with data this app understands. Make sure it is a Token Monitor Hub (not a sign-in page), and update Token Monitor on the Hub." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The address answered, but not with data this app understands. Make sure it is a Token Monitor Hub (not a sign-in page), and update Token Monitor on the Hub."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスは応答しましたが、このアプリが理解できるデータではありませんでした。Token Monitor Hub であること（サインインページではないこと）を確認し、Hub の Token Monitor を更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소가 응답했지만 이 앱이 이해할 수 있는 데이터가 아닙니다. Token Monitor Hub인지(로그인 페이지가 아닌지) 확인하고 Hub의 Token Monitor를 업데이트하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O endereço respondeu, mas não com dados que este app entende. Verifique se é um Token Monitor Hub (e não uma página de login) e atualize o Token Monitor no Hub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该地址有响应，但返回的不是此 App 能识别的数据。请确认它是 Token Monitor Hub（而不是登录页面），并更新 Hub 上的 Token Monitor。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此位址有回應，但回傳的不是此 App 能識別的資料。請確認它是 Token Monitor Hub（而不是登入頁面），並更新 Hub 上的 Token Monitor。"
          }
        }
      }
    },
    "This Hub refuses all requests until a secret is set. For a Cloudflare Worker, run “npx wrangler secret put TOKEN_MONITOR_SECRET”, then enter the same secret here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Hub refuses all requests until a secret is set. For a Cloudflare Worker, run “npx wrangler secret put TOKEN_MONITOR_SECRET”, then enter the same secret here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Hub はシークレットが設定されるまですべてのリクエストを拒否します。Cloudflare Worker の場合は「npx wrangler secret put TOKEN_MONITOR_SECRET」を実行し、同じシークレットをここに入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Hub는 시크릿이 설정될 때까지 모든 요청을 거부합니다. Cloudflare Worker라면 “npx wrangler secret put TOKEN_MONITOR_SECRET”을 실행한 다음 같은 시크릿을 여기에 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Hub recusa todas as solicitações até que um segredo seja definido. Para um Cloudflare Worker, execute “npx wrangler secret put TOKEN_MONITOR_SECRET” e informe o mesmo segredo aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设置密钥之前，此 Hub 会拒绝所有请求。如果是 Cloudflare Worker，请运行“npx wrangler secret put TOKEN_MONITOR_SECRET”，然后在此输入相同的密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在設定密鑰之前，此 Hub 會拒絕所有請求。如果是 Cloudflare Worker，請執行「npx wrangler secret put TOKEN_MONITOR_SECRET」，然後在此輸入相同的密鑰。"
          }
        }
      }
    },
    "This address uses plain HTTP over the internet, so the secret and your usage travel unencrypted. Use https:// unless the Hub is on your own network." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This address uses plain HTTP over the internet, so the secret and your usage travel unencrypted. Use https:// unless the Hub is on your own network."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアドレスはインターネット経由で暗号化されていない HTTP を使用するため、シークレットと使用量が暗号化されずに送信されます。Hub が自分のネットワーク上にない限り https:// を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소는 인터넷을 통해 암호화되지 않은 HTTP를 사용하므로 시크릿과 사용량이 암호화되지 않은 채 전송됩니다. Hub가 내 네트워크에 있지 않다면 https://를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este endereço usa HTTP sem criptografia pela internet, então o segredo e o seu uso trafegam sem criptografia. Use https://, a menos que o Hub esteja na sua própria rede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此地址通过互联网使用未加密的 HTTP，密钥和用量数据将以明文传输。除非 Hub 位于你自己的网络中，否则请使用 https://。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此位址透過網際網路使用未加密的 HTTP，密鑰和用量資料將以明文傳輸。除非 Hub 位於你自己的網路中，否則請使用 https://。"
          }
        }
      }
    },
    "This app only reads from your Hub. It never uploads anything." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app only reads from your Hub. It never uploads anything."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリは Hub からの読み取りのみを行い、何もアップロードしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 Hub에서 읽기만 하며 아무것도 업로드하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este app apenas lê do seu Hub. Ele nunca envia nada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 App 仅从你的 Hub 读取数据，从不上传任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 App 僅從你的 Hub 讀取資料，從不上傳任何內容。"
          }
        }
      }
    },
