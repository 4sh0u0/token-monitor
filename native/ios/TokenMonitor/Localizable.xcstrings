    "Transcripts stay on the computer that recorded this session. The Hub syncs only its usage." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripts stay on the computer that recorded this session. The Hub syncs only its usage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話記録はこのセッションを記録したコンピュータに残ります。Hub が同期するのは使用量のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화 기록은 이 세션을 기록한 컴퓨터에 남아 있습니다. Hub는 사용량만 동기화합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As transcrições ficam no computador que registrou esta sessão. O Hub sincroniza apenas o uso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
