    "Some devices don’t report exact token components, so this split is approximate." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some devices don’t report exact token components, so this split is approximate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正確なトークン内訳を報告しないデバイスがあるため、この内訳は概算です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 기기가 정확한 토큰 구성을 보고하지 않아 이 분류는 근사치입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dispositivos não informam os componentes exatos dos tokens, então esta divisão é aproximada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分设备未上报精确的 Token 构成，因此此拆分为近似值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分裝置未回報精確的 Token 構成，因此此拆分為近似值。"
          }
        }
      }
    },
