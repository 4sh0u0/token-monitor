    "Rings and money balances always show what is left. Widgets and Apple Watch always mask account emails." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rings and money balances always show what is left. Widgets and Apple Watch always mask account emails."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リングと残高は常に残量を表示します。ウィジェットと Apple Watch ではアカウントメールが常にマスクされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링과 금액 잔액은 항상 남은 양을 표시합니다. 위젯과 Apple Watch에서는 계정 이메일이 항상 가려집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anéis e saldos em dinheiro sempre mostram o que resta. Widgets e o Apple Watch sempre ocultam os e-mails das contas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圆环和金额余额始终显示剩余量。小组件和 Apple Watch 始终遮罩账号 Email。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圓環和金額餘額一律顯示剩餘量。小工具和 Apple Watch 一律遮罩帳號 Email。"
          }
        }
      }
    },
