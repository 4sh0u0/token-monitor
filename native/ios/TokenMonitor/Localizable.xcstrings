    "Full usage history couldn’t be loaded, so Trends shows the last 30 days without tool or model detail." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full usage history couldn’t be loaded, so Trends shows the last 30 days without tool or model detail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全な使用履歴を読み込めなかったため、トレンドには直近30日分のみがツール・モデル別の内訳なしで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
