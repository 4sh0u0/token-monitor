    "Deploy the repository’s worker folder to Cloudflare with a TOKEN_MONITOR_SECRET, then enter its https:// address. It works from anywhere, including mobile data." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deploy the repository’s worker folder to Cloudflare with a TOKEN_MONITOR_SECRET, then enter its https:// address. It works from anywhere, including mobile data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リポジトリの worker フォルダーを TOKEN_MONITOR_SECRET 付きで Cloudflare にデプロイし、その https:// アドレスを入力します。モバイルデータ通信を含め、どこからでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장소의 worker 폴더를 TOKEN_MONITOR_SECRET과 함께 Cloudflare에 배포한 다음 https:// 주소를 입력하세요. 모바일 데이터를 포함해 어디서나 작동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Implante a pasta worker do repositório no Cloudflare com um TOKEN_MONITOR_SECRET e informe o endereço https:// dele. Funciona de qualquer lugar, inclusive em dados móveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将仓库中的 worker 文件夹连同 TOKEN_MONITOR_SECRET 部署到 Cloudflare，然后输入其 https:// 地址。在任何地方都能使用，包括蜂窝数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將儲存庫中的 worker 資料夾連同 TOKEN_MONITOR_SECRET 部署到 Cloudflare，然後輸入其 https:// 位址。在任何地方都能使用，包括行動數據。"
          }
        }
      }
    },
