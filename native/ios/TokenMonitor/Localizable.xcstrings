    "The list is kept on your Hub and shared by every device. Edit it in Token Monitor on your computer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The list is kept on your Hub and shared by every device. Edit it in Token Monitor on your computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リストは Hub に保存され、すべてのデバイスで共有されます。編集はコンピュータの Token Monitor で行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
