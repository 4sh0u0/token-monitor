    "Cost excludes %@ tokens without a known price." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cost excludes %@ tokens without a known price."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格不明の %@ トークンはコストに含まれていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가격을 알 수 없는 %@ 토큰은 비용에 포함되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O custo não inclui %@ tokens sem preço conhecido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成本不含价格未知的 %@ Tokens。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成本不含價格未知的 %@ Tokens。"
          }
        }
      }
    },
    "Costs are always in USD, as on the desktop, whatever currency the app shows. The export covers every device on the Hub." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costs are always in USD, as on the desktop, whatever currency the app shows. The export covers every device on the Hub."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの表示通貨にかかわらず、デスクトップと同じくコストは常に USD です。エクスポートには Hub のすべてのデバイスが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱의 표시 통화와 관계없이 데스크톱과 마찬가지로 비용은 항상 USD입니다. 내보내기에는 Hub의 모든 기기가 포함됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os custos são sempre em USD, como no desktop, qualquer que seja a moeda exibida no app. A exportação inclui todos os dispositivos do Hub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与桌面版相同，无论 App 显示哪种货币，费用始终以 USD 计。导出包含 Hub 上的所有设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與桌面版相同，無論 App 顯示哪種貨幣，費用一律以 USD 計。匯出包含 Hub 上的所有裝置。"
          }
        }
      }
    },
    "Could not check whether this Hub syncs session titles." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not check whether this Hub syncs session titles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Hub がセッションタイトルを同期するか確認できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Hub가 세션 제목을 동기화하는지 확인할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível verificar se este Hub sincroniza títulos de sessões."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认此 Hub 是否同步会话标题。"
