    },
    "This Hub doesn’t provide full usage history, so Trends shows the last 30 days without tool or model detail." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Hub doesn’t provide full usage history, so Trends shows the last 30 days without tool or model detail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Hub は完全な使用履歴を提供していないため、トレンドには直近30日分のみがツール・モデル別の内訳なしで表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Hub는 전체 사용 기록을 제공하지 않으므로 추이에는 도구·모델별 세부 정보 없이 최근 30일만 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Hub não fornece o histórico de uso completo, então as Tendências mostram os últimos 30 dias sem detalhes por ferramenta ou modelo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Hub 未提供完整的使用历史，因此趋势仅显示近 30 天，且不含工具或模型明细。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Hub 未提供完整的使用歷史，因此趨勢僅顯示近 30 天，且不含工具或模型明細。"
          }
        }
      }
    },
    "This address uses plain HTTP over the internet, so the secret and your usage travel unencrypted. Use https:// unless the Hub is on your own network." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This address uses plain HTTP over the internet, so the secret and your usage travel unencrypted. Use https:// unless the Hub is on your own network."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアドレスはインターネット経由で暗号化されていない HTTP を使用するため、シークレットと使用量が暗号化されずに送信されます。Hub が自分のネットワーク上にない限り https:// を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소는 인터넷을 통해 암호화되지 않은 HTTP를 사용하므로 시크릿과 사용량이 암호화되지 않은 채 전송됩니다. Hub가 내 네트워크에 있지 않다면 https://를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este endereço usa HTTP sem criptografia pela internet, então o segredo e o seu uso trafegam sem criptografia. Use https://, a menos que o Hub esteja na sua própria rede."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此地址通过互联网使用未加密的 HTTP，密钥和用量数据将以明文传输。除非 Hub 位于你自己的网络中，否则请使用 https://。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此位址透過網際網路使用未加密的 HTTP，密鑰和用量資料將以明文傳輸。除非 Hub 位於你自己的網路中，否則請使用 https://。"
          }
        }
      }
    },
    "This app only reads from your Hub. It never uploads anything." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app only reads from your Hub. It never uploads anything."
