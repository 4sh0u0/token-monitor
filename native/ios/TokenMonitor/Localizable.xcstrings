    "Auto uses the day’s exchange rate. Manual keeps the rate you enter; clear it to go back to Auto." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto uses the day’s exchange rate. Manual keeps the rate you enter; clear it to go back to Auto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」はその日の為替レートを使います。「手動」は入力したレートを使い続けます。空にすると「自動」に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동은 당일 환율을 사용합니다. 수동은 입력한 환율을 유지하며, 지우면 자동으로 돌아갑니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automática usa a taxa de câmbio do dia. Manual mantém a taxa que você digitar; apague-a para voltar para Automática."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动使用当天的汇率。手动会保留你输入的汇率；清空即可改回自动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動使用當天的匯率。手動會保留你輸入的匯率；清空即可改回自動。"
          }
        }
      }
    },
