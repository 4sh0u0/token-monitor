    "Check that the Hub is running and that this iPhone is on the same network or tailnet. If you declined Local Network access, turn it on in Settings › Privacy & Security › Local Network." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that the Hub is running and that this iPhone is on the same network or tailnet. If you declined Local Network access, turn it on in Settings › Privacy & Security › Local Network."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub が起動していて、この iPhone が同じネットワークまたは tailnet に接続されていることを確認してください。ローカルネットワークへのアクセスを許可しなかった場合は、設定 › プライバシーとセキュリティ › ローカルネットワークでオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub가 실행 중이고 이 iPhone이 같은 네트워크 또는 tailnet에 연결되어 있는지 확인하세요. 로컬 네트워크 접근을 거부했다면 설정 › 개인정보 보호 및 보안 › 로컬 네트워크에서 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se o Hub está em execução e se este iPhone está na mesma rede ou tailnet. Se você recusou o acesso à Rede Local, ative-o em Ajustes › Privacidade e Segurança › Rede Local."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认 Hub 正在运行，并且这台 iPhone 与它位于同一网络或 tailnet。如果你曾拒绝本地网络访问，请在“设置 › 隐私与安全性 › 本地网络”中开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請確認 Hub 正在執行，且這支 iPhone 與它位於同一網路或 tailnet。如果你曾拒絕區域網路存取，請在「設定 › 隱私權與安全性 › 區域網路」中開啟。"
          }
        }
      }
    },
    "Check that the Hub is running, the address is right, and this iPhone is online." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check that the Hub is running, the address is right, and this iPhone is online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub が起動していること、アドレスが正しいこと、この iPhone がオンラインであることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hub가 실행 중인지, 주소가 올바른지, 이 iPhone이 온라인인지 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se o Hub está em execução, se o endereço está correto e se este iPhone está online."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确认 Hub 正在运行、地址正确，并且这台 iPhone 已联网。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請確認 Hub 正在執行、位址正確，且這支 iPhone 已連上網路。"
          }
        }
      }
    },
    "Check that the address points to a Token Monitor Hub." : {
