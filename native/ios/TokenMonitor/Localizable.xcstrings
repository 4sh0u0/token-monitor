    "Add what you pay for each AI account in Token Monitor on your computer. The list is kept on your Hub and shared by every device." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add what you pay for each AI account in Token Monitor on your computer. The list is kept on your Hub and shared by every device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各 AI アカウントに支払っている金額は、コンピュータの Token Monitor で追加します。リストは Hub に保存され、すべてのデバイスで共有されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 AI 계정에 지불하는 금액은 컴퓨터의 Token Monitor에서 추가하세요. 목록은 Hub에 저장되어 모든 기기가 공유합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o que você paga por cada conta de IA no Token Monitor do seu computador. A lista fica no seu Hub e é compartilhada por todos os dispositivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在电脑上的 Token Monitor 中添加你为每个 AI 账号支付的费用。这份清单存在 Hub 上，所有设备共用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在電腦上的 Token Monitor 中新增你為每個 AI 帳號支付的費用。這份清單存在 Hub 上，所有裝置共用。"
          }
        }
      }
    },
